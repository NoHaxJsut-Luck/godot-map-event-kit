}

static func resolve(locale: String) -> String:
	var base := locale.replace("-", "_").to_lower().get_slice("_", 0)
	if base == "zh": return "zh_CN"
	return base if base in ["en", "ja", "ko"] else "en"

static func text(source: String, locale: String) -> String:
	var language := resolve(locale)
	if language == "zh_CN" or not MESSAGES.has(source): return source
	var row: Array = MESSAGES[source]
	var index := ["en", "ja", "ko"].find(language)
	return str(row[index]) if not str(row[index]).is_empty() else str(row[0])
